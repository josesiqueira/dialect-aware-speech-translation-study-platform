# App
NODE_ENV=development
APP_URL=http://localhost:3000
# Recorded with every session and model run. Required when NODE_ENV=production
# (a missing value and "dev" are refused there).
APP_VERSION=dev
GIT_COMMIT_SHA=

# Database (the local Docker Compose Postgres listens on host port 5546)
# Development uses the postgres superuser of the local container for convenience.
# A deployment uses two least-privilege roles instead: docs/DEPLOYMENT.md, "Database roles".
DATABASE_URL=postgresql://postgres:postgres@localhost:5546/dialect_study
# Role that owns the schema, used only by `pnpm db:migrate`. Empty: DATABASE_URL is used.
MIGRATION_DATABASE_URL=

# Admin auth
# This file holds secrets. On a server: chmod 600 .env
# At least 12 characters in production. Use a random value: openssl rand -base64 18
# Changing it ends every admin session.
ADMIN_PASSWORD=
# At least 32 characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# OpenAI
OPENAI_API_KEY=

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/media

# Optional S3-compatible storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Upload / audio
MAX_AUDIO_UPLOAD_MB=100
MAX_UTTERANCE_SECONDS=300

# Worker
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=2000

# Sessions and proxy (web app)
# Lifetime of the admin session cookie, in hours.
ADMIN_SESSION_TTL_HOURS=8
# Lifetime of a participant session token, in hours.
PARTICIPANT_SESSION_TTL_HOURS=24
# Set to true only when exactly one trusted reverse proxy sits in front of the app.
# The client address for rate limiting is then read from the last x-forwarded-for entry.
# With false on a public APP_URL every client shares one rate limit bucket: the
# server prints a configuration warning at startup.
TRUST_PROXY=false

# AI
# Allow the deterministic mock AI provider. Leave empty for the default:
# true outside production, false in production.
AI_ALLOW_MOCK_PROVIDER=
# true: after the automatic ASR of an upload, the worker translates and synthesizes
# that recording in its own processing batch. Empty or false: batches are started by hand.
AUTO_TRANSLATE_AFTER_ASR=

# Logging
# One of: fatal, error, warn, info, debug, trace, silent. Leave empty for the default (info).
LOG_LEVEL=

# Allow the guarded "Delete TEST and DEMO data" action in production (default false)
ALLOW_TEST_DATA_RESET=false

# Worker tuning (worker process only). The defaults suit one worker.
# Jobs run at the same time in one worker process (1 to 16).
WORKER_CONCURRENCY=1
# A job whose worker stopped sending heartbeats for this long is released for a retry.
WORKER_LOCK_TIMEOUT_MS=600000
# How often the worker writes its heartbeat. At most half of WORKER_LOCK_TIMEOUT_MS.
WORKER_HEARTBEAT_INTERVAL_MS=10000
# How long the worker waits for running jobs after SIGTERM before it exits.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Audio tools. Leave empty to find ffmpeg and ffprobe in PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Tests only
# Server on which the tests create their own temporary databases
# (default postgresql://postgres:postgres@localhost:5546/postgres).
TEST_DATABASE_ADMIN_URL=
# Address of the running app for the Playwright tests (default http://localhost:3100).
E2E_BASE_URL=

# Containers: docker-compose.app.yml reads its own file, see docker/app.env.example.
