# Environment for the containers of docker-compose.app.yml.
# Copy to .env.docker in the repository root and fill in the secrets:
#   cp docker/app.env.example .env.docker
# .env.docker is ignored by Git and by the Docker build. Never commit real values.
# Every variable is described in docs/DEPLOYMENT.md, "Environment variables".
#
# NODE_ENV=production and LOCAL_STORAGE_ROOT=/data/media are set by the Compose file.

# App. APP_URL is the address people type in the browser. Use the https address
# when a TLS reverse proxy is in front.
APP_URL=http://localhost:3000
# Required in production: the released version, recorded with every session and
# model run. The server does not start without it, or with the value "dev".
APP_VERSION=0.1.0
GIT_COMMIT_SHA=

# Database. "postgres" is the service name in docker-compose.yml.
# Two roles, created by docker/postgres/create-roles.sh (docs/DEPLOYMENT.md,
# "Database roles"). Fill in the passwords you gave to that script. Never use the
# postgres superuser here.
# Web and worker: the application role (rows only, cannot change the schema).
#   postgresql://dialect_app:PASSWORD@postgres:5432/dialect_study
DATABASE_URL=
# Migrations only: the role that owns the schema.
#   postgresql://dialect_owner:PASSWORD@postgres:5432/dialect_study
MIGRATION_DATABASE_URL=

# Admin auth. In production the password needs at least 12 characters.
# Use a random value (openssl rand -base64 18). Changing it ends every admin session.
# This file holds secrets: chmod 600 .env.docker
ADMIN_PASSWORD=
# At least 32 characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=8
PARTICIPANT_SESSION_TTL_HOURS=24
# true only when exactly one trusted reverse proxy is in front of the web app.
# With false on a public APP_URL every client shares one rate limit bucket and
# the server prints a configuration warning at startup.
TRUST_PROXY=false

# OpenAI. Recording works without a key; processing jobs then fail until one is set.
OPENAI_API_KEY=
# The mock AI provider is off in production unless this is true. Never true for a real study.
AI_ALLOW_MOCK_PROVIDER=

# Storage: local (the media volume) or s3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Upload and audio limits
MAX_AUDIO_UPLOAD_MB=100
MAX_UTTERANCE_SECONDS=300

# Worker. Leave WORKER_ID empty to use the container host name.
WORKER_ID=
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1

# Logging: fatal, error, warn, info, debug, trace or silent (default info)
LOG_LEVEL=

# Allow "Delete TEST and DEMO data" in production (default false)
ALLOW_TEST_DATA_RESET=false
AUTO_TRANSLATE_AFTER_ASR=
